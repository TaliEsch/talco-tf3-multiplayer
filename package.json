{
  "name": "tf3-multiplayer-prototype",
  "version": "0.6.1",
  "private": true,
  "type": "module",
  "description": "Experimental encrypted direct-connect lockstep foundation for Transport Fever 3",
  "license": "MIT",
  "devDependencies": {
    "fengari": "0.1.5"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "test:local-session": "node tools/test-local-session.mjs",
