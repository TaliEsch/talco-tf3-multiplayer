    "test": "node --test --test-isolation=none \"test/*.test.mjs\"",
    "host": "node src/cli.mjs host",
    "join": "node src/cli.mjs join",
    "hash-game": "node src/cli.mjs hash-game",
    "hash-mod": "node src/cli.mjs hash-mod",
    "review": "node src/cli.mjs review --path mod"
  }
